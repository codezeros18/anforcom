# =============================================================================
# SISA — contoh variabel lingkungan
#
# Salin berkas ini menjadi `.env.local` untuk pengembangan lokal:
#   cp .env.example .env.local
#
# `.env.local` TIDAK ter-commit (lihat .gitignore). Jangan pernah menaruh nilai
# asli di berkas ini — berkas ini masuk repo publik dan dibaca siapa pun.
# =============================================================================

# --- Basis data --------------------------------------------------------------

# Connection string PostgreSQL yang dipakai Prisma saat runtime.
# Penyedia harus yang TIDAK menidurkan instance: layar publik wajib cepat kapan
# pun dibuka, termasuk berbulan-bulan setelah pembangunan berakhir. Penyedia
# tingkat gratis yang menidurkan instance akan lambat tepat saat orang pertama
# membuka tautannya.
DATABASE_URL="postgresql://pengguna:sandi@host:5432/sisa?sslmode=require"

# Catatan: `DIRECT_URL` tidak dipakai lagi. Prisma 7 menghapusnya — koneksi
# dibuka oleh driver adapter, bukan engine bawaan, jadi tidak ada lagi koneksi
# langsung yang perlu disebut terpisah dari koneksi ber-pooler.

# --- Model penglihatan -------------------------------------------------------

# Sakelar arsitektural terpenting proyek ini.
#
#   true  -> /src/vision memakai model-provider (panggil API model multimodal)
#   false -> /src/vision memakai manual-provider (fraksi dari slider operator)
#
# Dengan `false`, SELURUH alur pencatatan harus tetap jalan dari awal sampai
# akhir. Itu diuji di CI pada setiap push. Kalau uji itu gagal, isolasi model
# sudah bocor dan tugas dianggap gagal — bukan sekadar tes merah.
VISION_ENABLED=true

# Kunci API model multimodal. Hanya dibaca dari /src/vision — satu-satunya
# folder yang boleh memanggil API model.
# Kosongkan saat VISION_ENABLED=false.
VISION_API_KEY=""

# Model yang dipakai membaca fraksi keterisian dari foto.
# Kosongkan untuk memakai bawaan (claude-opus-5).
VISION_MODEL=""

# Batas waktu satu panggilan model, dalam milidetik. Setelah lewat batas ini,
# permintaan DIBATALKAN dan layar jatuh ke slider tanpa memunculkan error ke
# operator. Angka 6000 mengikat di BLUEPRINT bagian 8 — jangan diubah tanpa
# keputusan tertulis.
#
# Catatan: nilai ini belum dibaca dari env; batasnya ada sebagai tetapan
# TIMEOUT_MODEL_MS di /src/vision/provider.ts. Disebut di sini supaya
# angkanya terdokumentasi di satu tempat yang dibaca orang saat menyiapkan
# lingkungan.
VISION_TIMEOUT_MS=6000

# --- Penyimpanan foto --------------------------------------------------------

# Object storage S3-kompatibel. Foto diakses lewat URL bertanda tangan, tidak
# pernah lewat bucket publik. Metadata EXIF dihapus di server sebelum disimpan.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Masa berlaku URL bertanda tangan, dalam detik.
S3_URL_TTL_DETIK=900

# --- Aplikasi ----------------------------------------------------------------

# URL publik aplikasi. Dipakai untuk membangun tautan absolut.
# Lokal: http://localhost:3000
NEXT_PUBLIC_URL_APLIKASI="http://localhost:3000"

# === Endpoint riset (9.4) ===
# Membuka POST /api/riset/penimbangan dan POST /api/riset/tebakan.
#
# TERTUTUP SECARA BAWAAN. Kosong atau tidak diisi berarti kedua endpoint
# menjawab 404 seolah tidak ada. Isi "true" HANYA di lingkungan kerja lapangan
# tim — jangan pernah di production, karena penimbangan_referensi adalah sumber
# tunggal angka dampak (aturan keras 5).
#
# Perbandingannya ketat: hanya "true" yang membuka, bukan "1" atau "yes".
RISET_ENABLED="false"

# === Tanda tangan URL foto (9.6) ===
# Rahasia HMAC untuk tautan foto berumur 24 jam. Wajib diisi begitu penyimpanan
# objek dipasang; tanpa ini, pembuatan tautan foto melempar error dan TIDAK
# jatuh ke nilai bawaan — rahasia bawaan sama saja dengan tanpa tanda tangan.
FOTO_URL_SECRET=""
