{
  "name": "sisa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tonton": "vitest",
    "format": "prettier --write .",
    "format:cek": "prettier --check .",
    "seed": "node --env-file-if-exists=.env.local prisma/seed.mts",
    "db:migrasi": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:reset": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate reset --force",
    "db:segar": "npm run db:reset && npm run seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
